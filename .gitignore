# Unreal Engine
Binaries/
DerivedDataCache/
Intermediate/
Saved/
/GranTheftPraline/Build/
# Packaged games (tools/build/package-mac.sh), kept on the Mac only
/Builds/
*.sln
*.xcworkspace
.vs/
.idea/
.vscode/

# OS
.DS_Store

# Geodata: raw downloads stay out of Git
assets/geo/raw/**
!assets/geo/raw/.gitkeep

# Unreal per-user scratch content
**/Content/Developers/

# Epic sample content: used and packaged, never published in source form.
# Game Animation Sample folders copied by tools/character/install_gasp_content.sh
# (same /Game paths as in the sample). Our own content sits in
# Content/Characters/Player/ and Content/Input/GTP/.
/GranTheftPraline/Content/Audio/
/GranTheftPraline/Content/Blueprints/
/GranTheftPraline/Content/Characters/*
!/GranTheftPraline/Content/Characters/Player/
/GranTheftPraline/Content/Input/*
!/GranTheftPraline/Content/Input/GTP/
/GranTheftPraline/Content/Levels/
/GranTheftPraline/Content/Misc/
GranTheftPraline/Plugins/GameAnimationSample/
# Epic Vehicle template content (test car), copied by
# tools/vehicles/install_vehicle_template.sh; our cars live in Content/Vehicles/<Model>/.
/GranTheftPraline/Content/VehicleTemplate/
/GranTheftPraline/Content/Vehicles/SportsCar/
/GranTheftPraline/Content/Vehicles/OffroadCar/
/GranTheftPraline/Content/Vehicles/PhysicsMaterials/

# Fab and Megascans content, same rule
GranTheftPraline/Plugins/FabContent/
# Real shop signs and brands: kept locally, not covered by the MIT licence
GranTheftPraline/Plugins/CityBrands/

# Python
__pycache__/
*.pyc

# City pipeline tables are derived from OSM (ODbL): regenerate, do not commit
assets/geo/processed/*/*.csv
assets/geo/processed/*/*.geojson

# Prop pipeline: staging output is regenerated from the Tripo masters
assets/staging/
# City generation output (LiDAR, Grand Lyon, OSM derived): regenerate with tools/city/
assets/geo/processed/*/gen/
assets/geo/processed/*/terrain/
