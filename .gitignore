# Unreal Engine
Binaries/
DerivedDataCache/
Intermediate/
Saved/
/GranTheftPraline/Build/
# Packaged games (tools/build/package-mac.sh), kept on the Mac only
/Builds/
*.sln
*.xcworkspace
.vs/
.idea/
.vscode/

# OS
.DS_Store

# Geodata: raw downloads stay out of Git
assets/geo/raw/**
!assets/geo/raw/.gitkeep

# Unreal per-user scratch content
**/Content/Developers/

# Epic sample content: used and packaged, never published in source form.
# Game Animation Sample folders copied by tools/character/install_gasp_content.sh
# (same /Game paths as in the sample). Our own content sits in
# Content/Characters/Player/ and Content/Input/GTP/.
/GranTheftPraline/Content/Audio/
/GranTheftPraline/Content/Blueprints/
/GranTheftPraline/Content/Characters/*
!/GranTheftPraline/Content/Characters/Player/
/GranTheftPraline/Content/Input/*
!/GranTheftPraline/Content/Input/GTP/
/GranTheftPraline/Content/Levels/
/GranTheftPraline/Content/Misc/
GranTheftPraline/Plugins/GameAnimationSample/
# Epic Vehicle template content (test car), copied by
# tools/vehicles/install_vehicle_template.sh; our cars live in Content/Vehicles/<Model>/.
/GranTheftPraline/Content/VehicleTemplate/
/GranTheftPraline/Content/Vehicles/SportsCar/
/GranTheftPraline/Content/Vehicles/OffroadCar/
/GranTheftPraline/Content/Vehicles/PhysicsMaterials/

# Fab and Megascans content, same rule
GranTheftPraline/Plugins/FabContent/
# Real shop signs and brands: kept locally, not covered by the MIT licence
GranTheftPraline/Plugins/CityBrands/
# MassTraffic, copied from City Sample (Epic code, not covered by the MIT licence):
# docs/gameplay/traffic-mass.md
GranTheftPraline/Plugins/MassTraffic/
GranTheftPraline/Plugins/Traffic/
GranTheftPraline/Plugins/RuleProcessor/
# City Sample's vehicle base class, copied by tools/vehicles/copy_citysample_vehicle_base.py
GranTheftPraline/Plugins/CitySampleVehicleBase/
# City Sample's traffic content, kept at its City Sample /Game paths (Epic content)
/GranTheftPraline/Content/AI/Traffic/
/GranTheftPraline/Content/AI/ZoneGraphBuilder/
# Our copies of it, re-pointed by tools/city/unreal/place_masstraffic.py (still Epic content)
/GranTheftPraline/Content/AI/GTPTraffic/
/GranTheftPraline/Content/Vehicle/
# Epic vehicles migrated from City Sample Vehicles and the Vehicle Variety Pack
/GranTheftPraline/Content/Vehicles/Epic/

# Mini-map data derived from BD TOPO (tools/ui/minimap.py), regenerate
/GranTheftPraline/Content/City/Minimap/

# Game audio: generated (tools/audio) or recorded (Sonniss GDC, CC0) sounds and the
# surface maps derived from OSM/BD TOPO, imported on the Mac, never versioned
/GranTheftPraline/Content/Sound/

# Python
__pycache__/
*.pyc

# City pipeline tables are derived from OSM (ODbL): regenerate, do not commit
assets/geo/processed/*/*.csv
assets/geo/processed/*/*.geojson
assets/geo/processed/*/cells*.json
assets/geo/processed/*/landmarks.json

# Prop pipeline: staging output is regenerated from the Tripo masters
assets/staging/
# City generation output (LiDAR, Grand Lyon, OSM derived): regenerate with tools/city/
assets/geo/processed/*/gen/
assets/geo/processed/*/terrain/
# Driving lanes copied into the game by tools/city/traffic.py --map
/GranTheftPraline/Content/City/Traffic/

# Secrets / local scratch
.scratch/
*.env

# Tripo masters stay out of Git (registries only)
assets/tripo/**/*.glb
assets/tripo/**/*.fbx
assets/tripo/**/*.zip

# Day-night and weather assets and the night lights file, generated on the Mac
# by tools/environment (the lights come from OpenStreetMap tables, kept out of Git)
/GranTheftPraline/Content/Environment/Weather/
/GranTheftPraline/Content/Environment/Data/

# Fab and Megascans content added through the editor Fab window
/GranTheftPraline/Content/Fab/
/GranTheftPraline/Content/Megascans/
/GranTheftPraline/Content/MSPresets/
# Megascans tree packs added from the Fab library (Epic Games Launcher)
/GranTheftPraline/Content/EuropeanBeech/
/GranTheftPraline/Content/BlackAlder/
/GranTheftPraline/Content/Megaplant_Library/
/GranTheftPraline/Content/Scene_RoadsideConstruction/
